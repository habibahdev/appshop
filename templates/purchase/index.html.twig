{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-6 py-12">

    <h1 class="text-2xl font-medium text-stone-900 mb-10 pb-6 border-b border-stone-200">Mes commandes</h1>

    {% if purchases is empty %}
        <p class="text-sm text-stone-500 mb-6">Tu n'as pas encore passé de commande.</p>
        <a href="{{ path('app_catalog') }}" class="text-sm text-[#1B4332] hover:underline">Voir le catalogue &rarr;</a>
    {% else %}
    <div class="divide-y divide-stone-200">
        {% for purchase in purchases %}
        <a href="{{ path('order_show', {reference: purchase.reference}) }}"
           class="flex items-center justify-between py-5 hover:bg-stone-50 -mx-4 px-4 transition-colors">
            <div>
                <p class="text-sm text-stone-900">{{ purchase.reference }}</p>
                <p class="text-xs text-stone-400 mt-1">{{ purchase.createdAt|date('d/m/Y') }}</p>
            </div>
            <div class="flex items-center gap-6">
                <span class="text-xs uppercase tracking-wide px-2.5 py-1 border border-stone-200 text-stone-500">
                    {{ purchase.status|replace({'_': ' '}) }}
                </span>
                <span class="text-sm text-stone-900 w-20 text-right">{{ purchase.total|number_format(2, ',', ' ') }} €</span>
            </div>
        </a>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}