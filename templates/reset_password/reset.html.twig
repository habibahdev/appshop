{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
<div class="max-w-sm mx-auto px-6 py-24">
    <h1 class="text-2xl font-medium text-stone-900 mb-10">Nouveau mot de passe</h1>

    {{ form_start(resetForm) }}
        <div>
            {{ form_label(resetForm.plainPassword.first, 'Nouveau mot de passe', {label_attr: {class: 'text-xs uppercase tracking-wide text-stone-400 mb-2 block'}}) }}
            {{ form_widget(resetForm.plainPassword.first, {attr: {class: 'w-full text-sm border border-stone-200 px-3 py-2.5 focus:outline-none focus:border-[#1B4332]'}}) }}
            {{ form_errors(resetForm.plainPassword.first) }}
        </div>

        <div class="mt-5">
            {{ form_label(resetForm.plainPassword.second, 'Confirmer le mot de passe', {label_attr: {class: 'text-xs uppercase tracking-wide text-stone-400 mb-2 block'}}) }}
            {{ form_widget(resetForm.plainPassword.second, {attr: {class: 'w-full text-sm border border-stone-200 px-3 py-2.5 focus:outline-none focus:border-[#1B4332]'}}) }}
            {{ form_errors(resetForm.plainPassword.second) }}
        </div>

        <button type="submit"
                class="w-full bg-stone-900 text-white py-3 text-sm tracking-wide hover:bg-[#1B4332] transition-colors mt-6">
            Réinitialiser
        </button>
    {{ form_end(resetForm) }}
</div>
{% endblock %}