{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="max-w-sm mx-auto px-6 py-24">

    {% for flash_error in app.flashes('reset_password_error') %}
    <div class="text-sm text-red-600 mb-6">{{ flash_error }}</div>
    {% endfor %}

    <h1 class="text-2xl font-medium text-stone-900 mb-4">Mot de passe oublié</h1>
    <p class="text-sm text-stone-500 mb-10">
        Indique ton email, on t'enverra un lien pour réinitialiser ton mot de passe.
    </p>

    {{ form_start(requestForm) }}
        <div>
            {{ form_label(requestForm.email, 'Email', {label_attr: {class: 'text-xs uppercase tracking-wide text-stone-400 mb-2 block'}}) }}
            {{ form_widget(requestForm.email, {attr: {class: 'w-full text-sm border border-stone-200 px-3 py-2.5 focus:outline-none focus:border-[#1B4332]'}}) }}
            {{ form_errors(requestForm.email) }}
        </div>

        <button type="submit"
                class="w-full bg-stone-900 text-white py-3 text-sm tracking-wide hover:bg-[#1B4332] transition-colors mt-6">
            Envoyer le lien
        </button>
    {{ form_end(requestForm) }}

    <p class="text-sm text-stone-500 mt-8 text-center">
        <a href="{{ path('app_login') }}" class="text-[#1B4332] hover:underline">&larr; Retour à la connexion</a>
    </p>
</div>
{% endblock %}