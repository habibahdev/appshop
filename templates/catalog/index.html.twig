{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-6 py-12">

    <div class="flex items-end justify-between mb-10 border-b border-stone-200 pb-6">
        <h1 class="text-2xl font-medium text-stone-900">Catalogue</h1>
        <span class="text-sm text-stone-900">{{ totalProducts }} produit{{ totalProducts > 1 ? 's' : '' }}</span>
    </div>

    <div class="flex flex-col md:flex-row gap-10">

        <aside class="w-full md:w-56 shrink-0">
            <form method="get" class="space-y-8">
                <div>
                    <p class="text-xs uppercase tracking-wide text-stone-400 mb-3">Catégories</p>
                    <ul class="space-y-2 text-sm">
                        <li>
                            <a href="{{ path('app_catalog') }}"
                               class="{{ currentCategory ? 'text-stone-500' : 'text-[#1B4332] font-medium' }} hover:text-[#1B4332]">
                                Toutes
                            </a>
                        </li>
                        {% for category in categories %}
                        <li>
                            <a href="{{ path('app_catalog', {categorie: category.id}) }}"
                               class="{{ currentCategory == category.id ? 'text-[#1B4332] font-medium' : 'text-stone-500' }} hover:text-[#1B4332]">
                                {{ category.name }}
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>

                <div>
                    <label for="tri" class="text-xs uppercase tracking-wide text-stone-400 mb-3 block">Trier par</label>
                    <select name="tri" id="tri" onchange="this.form.submit()"
                            class="w-full text-sm border border-stone-200 rounded-none px-3 py-2 bg-transparent focus:outline-none focus:border-[#1B4332]">
                        <option value="newest" {{ currentSort == 'newest' ? 'selected' }}>Nouveautés</option>
                        <option value="price_asc" {{ currentSort == 'price_asc' ? 'selected' }}>Prix croissant</option>
                        <option value="price_desc" {{ currentSort == 'price_desc' ? 'selected' }}>Prix décroissant</option>
                        <option value="name" {{ currentSort == 'name' ? 'selected' }}>Nom</option>
                    </select>
                </div>
            </form>
        </aside>

        <div class="flex-1">
            {% if products is empty %}
                <p class="text-stone-500 text-sm">Aucun produit ne correspond à ta recherche.</p>
            {% else %}
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
                {% for product in products %}
                <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="group block">
                    <div class="aspect-4/5 bg-stone-100 mb-3 overflow-hidden">
                        {#{% if product.images.first %}
                        <img src="{{ asset('uploads/products/' ~ product.images.first.filename) }}"
                             alt="{{ product.name }}"
                             class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300">
                        {% endif %}#}
                    </div>
                    <h2 class="text-sm text-stone-900">{{ product.name }}</h2>
                    <p class="text-sm text-stone-500 mt-1">
                        {% if product.minPrice %}
                            À partir de {{ product.minPrice|number_format(2, ',', ' ') }} €
                        {% endif %}
                    </p>
                </a>
                {% endfor %}
            </div>

                {% if totalPages > 1 %}
                <nav class="flex items-center justify-center gap-1 mt-16">
                    {% if currentPage > 1 %}
                    <a href="{{ path('app_catalog', {categorie: currentCategory, tri: currentSort, q: search, page: currentPage - 1}) }}"
                    class="px-3 py-2 text-sm text-stone-500 hover:text-[#1B4332]">
                        &larr; Précédent
                    </a>
                    {% endif %}

                    {% for p in 1..totalPages %}
                        {% if p == currentPage %}
                        <span class="px-3 py-2 text-sm text-white bg-[#1B4332]">{{ p }}</span>
                        {% elseif p == 1 or p == totalPages or (p >= currentPage - 1 and p <= currentPage + 1) %}
                        <a href="{{ path('app_catalog', {categorie: currentCategory, tri: currentSort, q: search, page: p}) }}"
                        class="px-3 py-2 text-sm text-stone-600 hover:text-[#1B4332] border border-stone-200 hover:border-[#1B4332]">
                            {{ p }}
                        </a>
                        {% elseif p == currentPage - 2 or p == currentPage + 2 %}
                        <span class="px-2 text-stone-300">&hellip;</span>
                        {% endif %}
                    {% endfor %}

                    {% if currentPage < totalPages %}
                    <a href="{{ path('app_catalog', {categorie: currentCategory, tri: currentSort, q: search, page: currentPage + 1}) }}"
                    class="px-3 py-2 text-sm text-stone-500 hover:text-[#1B4332]">
                        Suivant &rarr;
                    </a>
                    {% endif %}
                </nav>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}