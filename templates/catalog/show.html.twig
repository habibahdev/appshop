{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-6 py-12">

    <a href="{{ path('app_catalog') }}" class="text-sm text-stone-500 hover:text-[#1B4332]">&larr; Catalogue</a>

    <div class="grid md:grid-cols-2 gap-12 mt-8">

        <div>
            <div class="aspect-[4/5] bg-stone-100 overflow-hidden">
                {% if product.images.first %}
                <img id="main-image" src="{{ asset('uploads/products/' ~ product.images.first.filename) }}"
                     alt="{{ product.name }}" class="w-full h-full object-cover">
                {% endif %}
            </div>
            {% if product.images|length > 1 %}
            <div class="flex gap-3 mt-3">
                {% for image in product.images %}
                <button onclick="document.getElementById('main-image').src = this.querySelector('img').src"
                        class="w-16 h-20 bg-stone-100 overflow-hidden border border-transparent hover:border-[#1B4332]">
                    <img src="{{ asset('uploads/products/' ~ image.filename) }}" class="w-full h-full object-cover">
                </button>
                {% endfor %}
            </div>
            {% endif %}
        </div>

        <div>
            <p class="text-xs uppercase tracking-wide text-stone-400 mb-2">{{ product.category.name }}</p>
            <h1 class="text-2xl font-medium text-stone-900 mb-4">{{ product.name }}</h1>

            <p id="variant-price" class="text-xl text-[#1B4332] mb-6">
                {{ product.variants.first ? product.variants.first.price|number_format(2, ',', ' ') ~ ' €' : '' }}
            </p>

            <form action="{{ path('app_cart_add') }}" method="post" class="space-y-6">
                <input type="hidden" name="product" value="{{ product.id }}">

                <div>
                    <p class="text-xs uppercase tracking-wide text-stone-400 mb-3">Choisir une variante</p>
                    <div class="flex flex-wrap gap-2">
                        {% for variant in product.variants %}
                        <label class="cursor-pointer">
                            <input type="radio" name="variant" value="{{ variant.id }}"
                                   data-price="{{ variant.price }}"
                                   {{ not variant.inStock ? 'disabled' }}
                                   class="peer sr-only" {{ loop.first ? 'checked' }}>
                            <span class="block px-4 py-2 text-sm border border-stone-200 peer-checked:border-[#1B4332] peer-checked:text-[#1B4332] peer-disabled:opacity-40 peer-disabled:line-through hover:border-stone-400">
                                {{ variant.label }}
                            </span>
                        </label>
                        {% endfor %}
                    </div>
                </div>

                <button type="submit"
                        class="w-full bg-[#1B4332] text-white py-3 text-sm tracking-wide hover:bg-[#143526] transition-colors">
                    Ajouter au panier
                </button>
            </form>

            {% if product.description %}
            <div class="mt-10 pt-8 border-t border-stone-200 text-sm text-stone-600 leading-relaxed">
                {{ product.description|nl2br }}
            </div>
            {% endif %}
        </div>
    </div>

    {% set avgRating = review_average(product) %}
    {% set approvedReviews = review_list(product) %}

    <div class="mt-16 pt-10 border-t border-stone-200">
        <div class="flex items-center gap-3 mb-8">
            <h2 class="text-lg font-medium text-stone-900">Avis</h2>
            {% if avgRating %}
            <span class="text-sm text-stone-500">{{ avgRating }}/5 · {{ approvedReviews|length }} avis</span>
            {% endif %}
        </div>

        {% if approvedReviews is empty %}
            <p class="text-sm text-stone-500 mb-10">Aucun avis pour le moment.</p>
        {% else %}
            <div class="space-y-6 mb-10">
                {% for review in approvedReviews %}
                <div class="border-b border-stone-100 pb-6">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-[#1B4332] text-sm">
                            {% for i in 1..5 %}{% if i <= review.rating %}★{% else %}☆{% endif %}{% endfor %}
                        </span>
                        {% if review.verifiedPurchase %}
                        <span class="text-[10px] uppercase tracking-wide text-stone-400 border border-stone-200 px-1.5 py-0.5">Achat vérifié</span>
                        {% endif %}
                    </div>
                    <p class="text-sm text-stone-600 leading-relaxed">{{ review.comment }}</p>
                    <p class="text-xs text-stone-400 mt-2">{{ review.user.fullName ?? 'Client' }} · {{ review.createdAt|date('d/m/Y') }}</p>
                </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if app.user %}
        <form action="{{ path('review_create', {slug: product.slug}) }}" method="post" class="max-w-md">
            <p class="text-xs uppercase tracking-wide text-stone-400 mb-3">Laisser un avis</p>
            <div class="flex gap-1 mb-4">
                {% for i in 1..5 %}
                <label>
                    <input type="radio" name="rating" value="{{ i }}" class="peer sr-only" {{ i == 5 ? 'checked' }}>
                    <span class="cursor-pointer text-xl text-stone-300 peer-checked:text-[#1B4332]">★</span>
                </label>
                {% endfor %}
            </div>
            <textarea name="comment" rows="3" required placeholder="Ton avis..."
                      class="w-full text-sm border border-stone-200 px-3 py-2 focus:outline-none focus:border-[#1B4332] mb-4"></textarea>
            <button type="submit" class="text-sm bg-stone-900 text-white px-6 py-2.5 hover:bg-[#1B4332] transition-colors">
                Envoyer
            </button>
        </form>
        {% else %}
        <p class="text-sm text-stone-500"><a href="{{ path('app_login') }}" class="text-[#1B4332] hover:underline">Connecte-toi</a> pour laisser un avis.</p>
        {% endif %}
    </div>
</div>

<script>
document.querySelectorAll('input[name="variant"]').forEach(input => {
    input.addEventListener('change', () => {
        const price = parseFloat(input.dataset.price).toLocaleString('fr-FR', {minimumFractionDigits: 2});
        document.getElementById('variant-price').textContent = price + ' €';
    });
});
</script>
{% endblock %}