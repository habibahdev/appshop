{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-6 py-12">

    <a href="{{ path('app_catalog') }}" class="text-sm text-stone-500 hover:text-[#1B4332]">&larr; Catalogue</a>

    <div class="grid md:grid-cols-2 gap-12 mt-8">

        <div>
            <div class="aspect-4/5 bg-stone-100 overflow-hidden">
                {% if product.images.first %}
                <img id="main-image" src="{{ asset('uploads/products/' ~ product.images.first.filename) }}"
                     alt="{{ product.name }}" class="w-full h-full object-cover">
                {% endif %}
            </div>
            {% if product.images|length > 1 %}
            <div class="flex gap-3 mt-3">
                {% for image in product.images %}
                <button onclick="document.getElementById('main-image').src = this.querySelector('img').src"
                        class="w-16 h-20 bg-stone-100 overflow-hidden border border-transparent hover:border-[#1B4332]">
                    <img src="{{ asset('uploads/products/' ~ image.filename) }}" class="w-full h-full object-cover">
                </button>
                {% endfor %}
            </div>
            {% endif %}
        </div>

        <div>
            <p class="text-xs uppercase tracking-wide text-stone-400 mb-2">{{ product.category.name }}</p>
            <h1 class="text-2xl font-medium text-stone-900 mb-4">{{ product.name }}</h1>

            <p id="variant-price" class="text-xl text-[#1B4332] mb-6">
                {{ product.variants.first ? product.variants.first.price|number_format(2, ',', ' ') ~ ' €' : '' }}
            </p>

            <form action="{{ path('app_cart_add') }}" method="post" class="space-y-6">
                <input type="hidden" name="product" value="{{ product.id }}">

                {% if colors is not empty %}
                    <div class="space-y-6">

                        {# =========================
                        TAILLE
                        ========================= #}
                        <div>
                            <p class="text-xs uppercase tracking-wide text-stone-400 mb-3">
                                Taille —
                                <span id="selected-size-label">Choisir</span>
                            </p>

                            <div class="flex flex-wrap gap-2" id="size-options"></div>
                        </div>

                        {# =========================
                        COULEUR
                        ========================= #}
                        <div>
                            <p class="text-xs uppercase tracking-wide text-stone-400 mb-3">
                                Couleur —
                                <span id="selected-color-label">Choisir</span>
                            </p>

                            <div class="flex flex-wrap gap-3" id="color-swatches">

                                {% for color in colors %}
                                    <button
                                        type="button"
                                        data-color="{{ color }}"
                                        class="color-swatch w-9 h-9 rounded-full ring-1 ring-stone-200 opacity-40 cursor-not-allowed transition-all"
                                        style="background-color: {{ color_hex(color) }};"
                                        title="{{ color }}"
                                        aria-label="{{ color }}"
                                    ></button>
                                {% endfor %}

                            </div>
                        </div>

                        <input
                            type="hidden"
                            name="variant"
                            id="selected-variant-input"
                            required
                        >

                    </div>

                    <script id="variant-matrix" type="application/json">
                        {{ matrix|json_encode|raw }}
                    </script>

                {% else %}

                    <div>
                        <p class="text-xs uppercase tracking-wide text-stone-400 mb-3">
                            Choisir une variante
                        </p>

                        <div class="flex flex-wrap gap-2">

                            {% for variant in product.variants %}

                                <label class="cursor-pointer">

                                    <input
                                        type="radio"
                                        name="variant"
                                        value="{{ variant.id }}"
                                        data-price="{{ variant.price }}"
                                        class="peer sr-only"
                                        {{ loop.first ? 'checked' }}
                                    >

                                    <span class="block px-4 py-2 text-sm border border-stone-200 peer-checked:border-[#1B4332] peer-checked:text-[#1B4332] hover:border-stone-400">
                                        {{ variant.label }}
                                    </span>

                                </label>

                            {% endfor %}

                        </div>
                    </div>

                {% endif %}

                <button type="submit"
                        class="w-full bg-[#1B4332] text-white py-3 text-sm tracking-wide cursor-pointer hover:bg-[#143526] transition-colors">
                    Ajouter au panier
                </button>
            </form>

            {% if product.description %}
            <div class="mt-10 pt-8 border-t border-stone-200 text-sm text-stone-600 leading-relaxed">
                {{ product.description|nl2br }}
            </div>
            {% endif %}
        </div>
    </div>

    {% set avgRating = review_average(product) %}
    {% set approvedReviews = review_list(product) %}

    <div class="mt-16 pt-10 border-t border-stone-200">
        <div class="flex items-center gap-3 mb-8">
            <h2 class="text-lg font-medium text-stone-900">Avis</h2>
            {% if avgRating %}
            <span class="text-sm text-stone-500">{{ avgRating }}/5 · {{ approvedReviews|length }} avis</span>
            {% endif %}
        </div>

        {% if approvedReviews is empty %}
            <p class="text-sm text-stone-500 mb-10">Aucun avis pour le moment.</p>
        {% else %}
            <div class="space-y-6 mb-10">
                {% for review in approvedReviews %}
                <div class="border-b border-stone-100 pb-6">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-[#1B4332] text-sm">
                            {% for i in 1..5 %}{% if i <= review.rating %}★{% else %}☆{% endif %}{% endfor %}
                        </span>
                        {% if review.verifiedPurchase %}
                        <span class="text-[10px] uppercase tracking-wide text-stone-400 border border-stone-200 px-1.5 py-0.5">Achat vérifié</span>
                        {% endif %}
                    </div>
                    <p class="text-sm text-stone-600 leading-relaxed">{{ review.comment }}</p>
                    <p class="text-xs text-stone-400 mt-2">{{ review.user.fullName ?? 'Client' }} · {{ review.createdAt|date('d/m/Y') }}</p>
                </div>
                {% endfor %}
            </div>
        {% endif %}
        
        {% if app.user %}
        <form action="{#{{ path('review_create', {slug: product.slug}) }}#}" method="post" class="max-w-md">
            <p class="text-xs uppercase tracking-wide text-stone-400 mb-3">Laisser un avis</p>
            <div class="flex gap-1 mb-4">
                {% for i in 1..5 %}
                <label>
                    <input type="radio" name="rating" value="{{ i }}" class="peer sr-only" {{ i == 5 ? 'checked' }}>
                    <span class="cursor-pointer text-xl text-stone-300 peer-checked:text-[#1B4332]">★</span>
                </label>
                {% endfor %}
            </div>
            <textarea name="comment" rows="3" required placeholder="Ton avis..."
                      class="w-full text-sm border border-stone-200 px-3 py-2 focus:outline-none focus:border-[#1B4332] mb-4 resize-none"></textarea>
            <button type="submit" class="text-sm bg-stone-900 text-white px-6 py-2.5 hover:bg-[#1B4332] transition-colors">
                Envoyer
            </button>
        </form>
        {% else %}
        <p class="text-sm text-stone-500"><a href="{{ path('app_login') }}" class="text-[#1B4332] hover:underline">Connecte-toi</a> pour laisser un avis.</p>
        {% endif %}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {

    const matrixElement = document.getElementById('variant-matrix');

    if (!matrixElement) {
        return;
    }

    const matrix = JSON.parse(matrixElement.textContent);

    const sizeContainer = document.getElementById('size-options');
    const colorSwatches = document.querySelectorAll('.color-swatch');

    const variantInput = document.getElementById('selected-variant-input');

    const priceElement = document.getElementById('variant-price');

    const selectedSizeLabel =
        document.getElementById('selected-size-label');

    const selectedColorLabel =
        document.getElementById('selected-color-label');


    /*
     * ==========================================================
     * ORDRE DES TAILLES
     * ==========================================================
     */

    const sizeOrder = [
        'XS',
        'S',
        'M',
        'L',
        'XL',
        'XXL'
    ];


    /*
     * ==========================================================
     * RÉCUPÉRATION DE TOUTES LES TAILLES
     * ==========================================================
     */

    const allSizes = new Set();

    Object.keys(matrix).forEach(color => {

        Object.keys(matrix[color]).forEach(size => {

            allSizes.add(size);

        });

    });


    /*
     * ==========================================================
     * TRI DES TAILLES
     * ==========================================================
     */

    const sizes = Array.from(allSizes).sort((a, b) => {

        const indexA = sizeOrder.indexOf(a);
        const indexB = sizeOrder.indexOf(b);

        if (indexA === -1 && indexB === -1) {
            return a.localeCompare(b);
        }

        if (indexA === -1) {
            return 1;
        }

        if (indexB === -1) {
            return -1;
        }

        return indexA - indexB;

    });


    /*
     * ==========================================================
     * RÉCUPÉRER LES COULEURS D'UNE TAILLE
     * ==========================================================
     */

    function getColorsForSize(size) {

        const result = {};

        Object.keys(matrix).forEach(color => {

            if (matrix[color][size]) {

                result[color] = matrix[color][size];

            }

        });

        return result;

    }


    /*
     * ==========================================================
     * AFFICHER LES TAILLES
     * ==========================================================
     */

    function renderSizes() {

        sizeContainer.innerHTML = '';

        sizes.forEach((size, index) => {

            const label = document.createElement('label');

            label.className = 'cursor-pointer';


            const input = document.createElement('input');

            input.type = 'radio';
            input.name = 'size_choice';
            input.value = size;

            input.className = 'peer sr-only';


            const span = document.createElement('span');

            span.className = `
                flex
                items-center
                justify-center
                min-w-12
                h-10
                px-3
                rounded-full
                border
                border-stone-200
                text-sm
                transition-all
                hover:border-stone-400
                peer-checked:border-[#1B4332]
                peer-checked:bg-[#1B4332]
                peer-checked:text-white
            `;

            span.textContent = size;


            input.addEventListener('change', () => {

                selectSize(size);

            });


            label.appendChild(input);
            label.appendChild(span);

            sizeContainer.appendChild(label);


            /*
             * Première taille sélectionnée
             */
            if (index === 0) {

                input.checked = true;

            }

        });

    }


    /*
     * ==========================================================
     * AFFICHER LES COULEURS POUR UNE TAILLE
     * ==========================================================
     */

    function renderColors(size) {

        const colorsForSize = getColorsForSize(size);


        colorSwatches.forEach(swatch => {

            const color = swatch.dataset.color;

            const variant = colorsForSize[color];


            /*
             * Réinitialisation
             */
            swatch.classList.remove(
                'ring-2',
                'ring-[#1B4332]',
                'ring-offset-2',
                'opacity-20',
                'opacity-30',
                'opacity-40',
                'cursor-pointer',
                'cursor-not-allowed'
            );


            /*
             * La couleur n'existe pas pour cette taille
             */
            if (!variant) {

                swatch.disabled = true;

                swatch.classList.add(
                    'opacity-20',
                    'cursor-not-allowed'
                );

                return;

            }


            /*
             * La couleur existe mais est en rupture
             */
            if (!variant.inStock) {

                swatch.disabled = true;

                swatch.classList.add(
                    'opacity-30',
                    'cursor-not-allowed'
                );

                return;

            }


            /*
             * La couleur est disponible
             */
            swatch.disabled = false;

            swatch.classList.add(
                'opacity-100',
                'cursor-pointer'
            );

        });

    }


    /*
     * ==========================================================
     * SÉLECTIONNER UNE COULEUR
     * ==========================================================
     */

    function selectColor(color, size) {

        const variant = matrix[color]?.[size];


        /*
         * Sécurité
         */
        if (!variant || !variant.inStock) {

            return;

        }


        /*
         * Mise à jour du texte
         *
         * IMPORTANT :
         * c'est ici que "Couleur — Noir"
         * devient par exemple "Couleur — Rouge"
         */
        selectedColorLabel.textContent = color;


        /*
         * Mise à jour de la variante
         */
        variantInput.value = variant.id;


        /*
         * Mise à jour du prix
         */
        if (priceElement) {

            priceElement.textContent =
                variant.price.toLocaleString(
                    'fr-FR',
                    {
                        minimumFractionDigits: 2
                    }
                ) + ' €';

        }


        /*
         * Mise à jour visuelle des pastilles
         */
        colorSwatches.forEach(swatch => {

            const isSelected =
                swatch.dataset.color === color;


            swatch.classList.toggle(
                'ring-2',
                isSelected
            );

            swatch.classList.toggle(
                'ring-[#1B4332]',
                isSelected
            );

            swatch.classList.toggle(
                'ring-offset-2',
                isSelected
            );

        });

    }


    /*
     * ==========================================================
     * SÉLECTIONNER UNE TAILLE
     * ==========================================================
     */

    function selectSize(size) {

        /*
         * Mise à jour du texte
         */
        selectedSizeLabel.textContent = size;


        /*
         * Afficher uniquement les couleurs
         * disponibles pour cette taille
         */
        renderColors(size);


        /*
         * Récupération des couleurs disponibles
         */
        const colorsForSize = getColorsForSize(size);


        /*
         * Cherche la première couleur disponible
         */
        const firstAvailableColor =
            Object.entries(colorsForSize)
                .find(([, variant]) => variant.inStock);


        /*
         * Aucune couleur disponible
         */
        if (!firstAvailableColor) {

            selectedColorLabel.textContent = 'Aucune';

            variantInput.value = '';

            if (priceElement) {

                priceElement.textContent = '';

            }

            return;

        }


        /*
         * Sélection automatique de la première couleur
         */
        const firstColor = firstAvailableColor[0];

        selectColor(firstColor, size);

    }


    /*
     * ==========================================================
     * CLIC SUR UNE COULEUR
     * ==========================================================
     */

    colorSwatches.forEach(swatch => {

        swatch.addEventListener('click', () => {

            const selectedSize =
                document.querySelector(
                    'input[name="size_choice"]:checked'
                )?.value;


            if (!selectedSize) {

                return;

            }


            const color = swatch.dataset.color;


            selectColor(
                color,
                selectedSize
            );

        });

    });


    /*
     * ==========================================================
     * INITIALISATION
     * ==========================================================
     */

    renderSizes();


    if (sizes.length > 0) {

        selectSize(sizes[0]);

    }

});
</script>
{% endblock %}