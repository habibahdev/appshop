{% extends 'base.html.twig' %}

{% block title %}Téléphone{% endblock %}

{% block body %}
<div class="max-w-sm mx-auto px-6 py-24">
    <a href="{{ path('app_profile') }}" class="text-sm text-stone-500 hover:text-[#1B4332]">&larr; Profil</a>

    <h1 class="text-2xl font-medium text-stone-900 mt-6 mb-10">Numéro de téléphone</h1>

    {{ form_start(form) }}
        <div>
            {{ form_label(form.phone, null, {label_attr: {class: 'text-xs uppercase tracking-wide text-stone-400 mb-2 block'}}) }}
            {{ form_widget(form.phone, {attr: {class: 'w-full text-sm border border-stone-200 px-3 py-2.5 focus:outline-none focus:border-[#1B4332]'}}) }}
            {{ form_errors(form.phone) }}
        </div>

        <button type="submit"
                class="w-full bg-stone-900 text-white py-3 text-sm tracking-wide hover:bg-[#1B4332] transition-colors mt-6">
            Enregistrer
        </button>
    {{ form_end(form) }}
</div>
{% endblock %}