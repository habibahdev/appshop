{% extends 'base.html.twig' %}

{% block title %}Mot de passe{% endblock %}

{% block body %}
<div class="max-w-sm mx-auto px-6 py-24">
    <a href="{{ path('app_profile') }}" class="text-sm text-stone-500 hover:text-[#1B4332]">&larr; Profil</a>

    <h1 class="text-2xl font-medium text-stone-900 mt-6 mb-10">Changer mon mot de passe</h1>

    {{ form_start(form) }}
        <div>
            {{ form_label(form.currentPassword, 'Mot de passe actuel', {label_attr: {class: 'text-xs uppercase tracking-wide text-stone-400 mb-2 block'}}) }}
            {{ form_widget(form.currentPassword, {attr: {class: 'w-full text-sm border border-stone-200 px-3 py-2.5 focus:outline-none focus:border-[#1B4332]'}}) }}
            {{ form_errors(form.currentPassword) }}
        </div>

        <div class="mt-5">
            {{ form_label(form.plainPassword.first, 'Nouveau mot de passe', {label_attr: {class: 'text-xs uppercase tracking-wide text-stone-400 mb-2 block'}}) }}
            {{ form_widget(form.plainPassword.first, {attr: {class: 'w-full text-sm border border-stone-200 px-3 py-2.5 focus:outline-none focus:border-[#1B4332]'}}) }}
            {{ form_errors(form.plainPassword.first) }}
        </div>

        <div class="mt-5">
            {{ form_label(form.plainPassword.second, 'Confirmer le nouveau mot de passe', {label_attr: {class: 'text-xs uppercase tracking-wide text-stone-400 mb-2 block'}}) }}
            {{ form_widget(form.plainPassword.second, {attr: {class: 'w-full text-sm border border-stone-200 px-3 py-2.5 focus:outline-none focus:border-[#1B4332]'}}) }}
            {{ form_errors(form.plainPassword.second) }}
        </div>

        <button type="submit"
                class="w-full bg-stone-900 text-white py-3 text-sm tracking-wide hover:bg-[#1B4332] transition-colors mt-6">
            Mettre à jour
        </button>
    {{ form_end(form) }}
</div>
{% endblock %}